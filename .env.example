# Copy to .env (optional). Studio Forge uses whatever the local Claude Code CLI is
# signed in with — usually you don't need anything here.

# Long-lived Claude subscription token, created with `claude setup-token`.
# CLAUDE_CODE_OAUTH_TOKEN=

# Or an Anthropic Console API key (pay-as-you-go billing instead of a subscription).
# ANTHROPIC_API_KEY=

# Port for the local web app (default 4317).
# FORGE_PORT=4317

# Path to the claude executable if it isn't on PATH.
# CLAUDE_PATH=claude
